{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "theceo-site",
  "main": "worker.js",
  "compatibility_date": "2026-10-19",
  "compatibility_flags": ["nodejs_compat"],
  "keep_vars": true,
  "routes": [{ "pattern": "theceo.dev", "custom_domain": true }],
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": ["/administrator", "/administrator/*", "/uploads/*"]
  },
  // Content database. Wrangler creates it on first deploy if it does not exist yet.
  "d1_databases": [{ "binding": "DB", "database_name": "theceo-content", "migrations_dir": "migrations" }],
  // Uploaded images and files.
  "r2_buckets": [{ "binding": "MEDIA", "bucket_name": "theceo-media" }],
  // Story cache, run log, used-story list, login lockouts.
  "kv_namespaces": [{ "binding": "NEWS" }],
  // Workers AI writes the hourly auto-posts.
  "ai": { "binding": "AI" },
  // Hourly: collect stories (Google + Bing News) and auto-post the top one per blog category.
  "triggers": { "crons": ["0 * * * *"] },
  "observability": { "enabled": true }
}
