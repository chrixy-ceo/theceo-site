---
import { ops, CC } from '../lib/ops.js';
import { posts } from '../lib/posts.js';
const { active = '' } = Astro.props;
const list = Object.keys(CC).filter((k) => ops.some((o) => o.category === k));
---
{list.length > 0 && <div class="fl cmenu" role="group" aria-label="Infobytes menu"><a href="/infobytes/" class={active === '' ? 'on' : ''}>All opportunities</a>{list.map((k) => <a href={`/infobytes/?cat=${k}`} class={active === k ? 'on' : ''}><i style={`background:${CC[k]}`}></i>{k}</a>)}{posts.length > 0 && <a href="/blog/">Blog →</a>}</div>}
<style is:global>.cmenu{margin:0 0 26px}.cmenu a{display:inline-flex;align-items:center;gap:8px}.cmenu a i{width:8px;height:8px;border-radius:50%}</style>
