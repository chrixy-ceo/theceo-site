---
import { renderMarkdown } from '../../lib/content.js';
import Shell from '../../layouts/Shell.astro';
import AdSlot from '../../components/AdSlot.astro';
import Newsletter from '../../components/Newsletter.astro';
import { getOps, CC, fdate } from '../../lib/ops.js';
const ops = getOps();
const o = ops.find((x) => x.slug === Astro.params.slug);
if (!o) return Astro.rewrite('/404');
const col = CC[o.category] || '#14b8a6';
---
<Shell title={o.title} desc={o.description || o.excerpt || ''} image={o.og_image || o.image} type="article" header={false} active="info">
<div class="tb"><div class="crumb" role="navigation" aria-label="Breadcrumb"><a href="/infobytes/">← Infobytes</a><span>/</span><a href={`/infobytes/?cat=${o.category}`} style={`--c:${col}`}><i></i>{o.category}</a></div><button class="btn tgl" id="th2" aria-label="Toggle light and dark theme"><svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><circle cx="12" cy="12" r="8.5"/><path d="M12 3.5a8.5 8.5 0 0 1 0 17z" fill="currentColor"/></svg></button></div>
<div class="od" style={`--c:${col}`}>
<article class="ar2"><div class="hi" style={`--c:${col}`}>{o.image ? <img class="th" src={o.image} alt="" /> : <div class="th ph3"><svg viewBox="0 0 24 24"><rect x="3" y="4" width="18" height="16" rx="3"/><path d="M3 17l5-5 4 4 3-3 6 5M8.5 9h.01"/></svg></div>}</div><small class="cat">{o.category}</small><h1>{o.title}</h1><p class="meta">{o.organization_logo && <img class="olg" src={o.organization_logo} alt="" />}{o.organization}</p><style is:global>.olg{height:22px;width:auto;vertical-align:middle;margin-right:8px;border-radius:6px}</style>
<div class="rem" id="rem" hidden><div class="ri"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="5" width="18" height="16" rx="3"/><path d="M3 10h18M8 3v4M16 3v4M9 15l2 2 4-4"/></svg></div><div class="rt"><b>Never miss this deadline <span class="nw">New</span></b><span>Add a reminder to your phone’s calendar.</span></div><div class="rb"><a class="btn p" id="gcal" target="_blank" rel="noopener" href="#">Google Calendar</a><a class="btn" id="ics" href="#">Apple / Outlook</a></div></div><Fragment set:html={renderMarkdown(o.body)} /></article>
<aside class="fx"><div><span>Deadline</span>{o.deadline ? <><b>{fdate(o.deadline)}</b><em data-dl={o.deadline}></em></> : <><b>No deadline</b><em>Open</em></>}</div><div><span>Location</span><b>{o.location}</b></div><div><span>Type</span><b>{o.type}</b></div>{o.apply_url && <a class="btn p big" href={o.apply_url} target="_blank" rel="noopener">Apply now</a>}<a class="btn" data-share target="_blank" rel="noopener" href="#">Share on WhatsApp</a><AdSlot /></aside>
</div>
<Newsletter where="info" />
<AdSlot />
<script define:vars={{ DL: o.deadline, TITLE: o.title, SLUG: o.slug }}>
const pad=n=>String(n).padStart(2,'0'),ymd=x=>x.getFullYear()+pad(x.getMonth()+1)+pad(x.getDate());
const d=new Date(DL+'T00:00:00'),n=new Date(d);n.setDate(n.getDate()+1);
if(DL&&Math.ceil((d-new Date())/864e5)>0){
const BS=String.fromCharCode(92),NL=String.fromCharCode(10),esc=t=>t.split(BS).join(BS+BS).split(';').join(BS+';').split(',').join(BS+',').split(NL).join(BS+'n');
const al=(t,m)=>['BEGIN:VALARM','ACTION:DISPLAY','DESCRIPTION:'+m,'TRIGGER:'+t,'END:VALARM'];
const ics=['BEGIN:VCALENDAR','VERSION:2.0','PRODID:-//Infobytes//EN','BEGIN:VEVENT','UID:'+SLUG+'@infobytes','DTSTAMP:'+new Date().toISOString().replace(/[-:]/g,'').slice(0,15)+'Z','DTSTART;VALUE=DATE:'+ymd(d),'DTEND;VALUE=DATE:'+ymd(n),'SUMMARY:'+esc('Deadline: '+TITLE),'DESCRIPTION:'+esc('Details and how to apply: '+location.href),'URL:'+location.href,...al('-P2DT15H','Deadline in 3 days'),...al('-PT15H','Deadline tomorrow'),...al('PT8H','Deadline is today'),'END:VEVENT','END:VCALENDAR'].join(String.fromCharCode(13)+NL);
document.getElementById('gcal').href='https://calendar.google.com/calendar/render?action=TEMPLATE&text='+encodeURIComponent('Deadline: '+TITLE)+'&dates='+ymd(d)+'/'+ymd(n)+'&details='+encodeURIComponent('Details and how to apply: '+location.href);
const a=document.getElementById('ics');a.href='data:text/calendar;charset=utf-8,'+encodeURIComponent(ics);a.download=SLUG+'.ics';
document.getElementById('rem').hidden=false}
</script>
</Shell>
