---
import '../styles/site.css';
import s from '../content/settings.json';
import site from '../content/site.json';
const { title, desc = '', header = true, ads = true, active = '' } = Astro.props;
const adsOn = ads && site.ads_enabled && site.adsense_client;
---
<!DOCTYPE html><html lang="en" data-theme="dark"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width, initial-scale=1"><title>{title}</title><meta name="description" content={desc}><link rel="icon" href="data:,">{site.adsense_client && <meta name="google-adsense-account" content={site.adsense_client} />}{adsOn && <script is:inline async src={`https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=${site.adsense_client}`} crossorigin="anonymous"></script>}<link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet"><style is:global>.ar2 ul,.ar2 ol{margin:14px 0 14px 22px;color:var(--mu)}.ar2 img{max-width:100%;border-radius:16px;margin:18px 0}.ar2 a{color:var(--teal);text-decoration:underline}.ar2 h2{display:block;font-size:20px;margin:30px 0 8px}.ar2 h2::after{display:none}.ar2 h3{margin-top:26px}.ar2 strong{color:var(--tx)}</style></head>
<body><div id="pg"></div><div id="blog"><section><div class="w">
{header && <header class="sh2"><a class="bn" href="/"><span class="fn">{s.name}</span><span class="so" set:html={s.short_name.replace(/\./g,"<b>.</b>")}></span></a><div class="sn"><a href="/">Portfolio</a><a href="/blog/" class={active == 'blog' ? 'on' : ''}>Blog</a><a href="/infobytes/" class={active == 'info' ? 'on' : ''}>Infobytes</a></div><button class="btn" id="th2" aria-label="Toggle light and dark theme">◐</button></header>}
<slot />
<div class="au"><img alt="" src={s.photo}><a class="btn p" href="/">View my portfolio</a></div>
<p class="legal lgl"><a href="/about/">About</a><a href="/contact/">Contact</a><a href="/privacy/">Privacy</a><a href="/terms/">Terms</a><a href="/disclaimer/">Disclaimer</a></p>
</div></section></div><script is:inline>
const R=document.documentElement;try{R.dataset.theme=localStorage.th||(matchMedia('(prefers-color-scheme:light)').matches?'light':'dark')}catch(e){}
document.addEventListener('click',e=>{if(e.target.closest('#th2')){R.dataset.theme=R.dataset.theme=='dark'?'light':'dark';try{localStorage.th=R.dataset.theme}catch(x){}}});
document.querySelectorAll('[data-share]').forEach(a=>a.href='https://wa.me/?text='+encodeURIComponent(document.title+' '+location.href));
document.querySelectorAll('[data-dl]').forEach(e=>{const d=Math.ceil((new Date(e.dataset.dl)-new Date())/864e5);e.textContent=d>0?d+' days left':'Closed'});
addEventListener('scroll',()=>{const p=document.getElementById('pg');if(p&&document.querySelector('.ar2'))p.style.width=scrollY/Math.max(1,document.documentElement.scrollHeight-innerHeight)*100+'%'});
</script></body></html>
