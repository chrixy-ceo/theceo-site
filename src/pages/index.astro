---
// Portfolio home. Premium editorial design; every word, image and link comes from D1 and is
// editable in /administrator (Portfolio text, About, Services, Stack, Projects, Certifications).
import { settings as s, site, about, services as sv, stack as st, projects, experience, certifications } from '../lib/content.js';
import { getPosts, fdate } from '../lib/posts.js';
import Meta from '../components/Meta.astro';

const posts = getPosts().slice(0, 3);
const role = (s.seo_title || '').split('|')[1]?.trim() || 'Data & AI';
const paras = (about.paragraphs || []).map((p) => String(p).replace(/\n/g, ' ').trim()).filter(Boolean);
const greeting = paras[0] || '';
const story = paras.slice(1);
const services = sv.items || [];
const tools = st.tools || [];
const GROUPS = [['analysis', 'Analysis'], ['automation', 'Automation'], ['other', 'Products & builds']];
const work = [...projects].sort((a, b) => String(b.date || '').localeCompare(String(a.date || '')));
const groups = GROUPS.map(([k, label]) => ({ k, label, items: work.filter((p) => (p.category || 'other') === k) })).filter((g) => g.items.length);
const certs = [...certifications].sort((a, b) => String(b.year || '').localeCompare(String(a.year || '')));
const exp = [...experience].sort((a, b) => String(b.start || '').localeCompare(String(a.start || '')));
const mo = (d) => (d ? new Date(d + '-01').toLocaleDateString('en-GB', { month: 'short', year: 'numeric' }) : '');
const wa = 'https://wa.me/' + (s.whatsapp || '');
// Put the last two words of the headline in italic teal for an editorial accent.
const hw = String(s.headline || '').trim().replace(/\.$/, '').split(' ');
const headA = hw.slice(0, -2).join(' '), headB = hw.slice(-2).join(' ');
const socials = [['LinkedIn', s.linkedin], ['X', s.x], ['GitHub', s.github]].filter(([, u]) => u);
const initials = (n) => n.replace(/[^A-Za-z0-9 ]/g, '').split(' ').map((w) => w[0]).join('').slice(0, 2).toUpperCase();
---
<!DOCTYPE html>
<html lang="en" data-theme="light">
<head>
<meta charset="utf-8"><meta name="viewport" content="width=device-width, initial-scale=1">
<Meta title={s.seo_title} description={s.seo_description} image={s.home_og_image} path="/" />
{site.adsense_client && <meta name="google-adsense-account" content={site.adsense_client} />}
<link rel="preconnect" href="https://fonts.googleapis.com"><link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Fraunces:ital,opsz,wght@0,9..144,400;0,9..144,500;0,9..144,600;1,9..144,400;1,9..144,500&family=Inter:wght@400;500;600&display=swap" rel="stylesheet">
<script is:inline>document.documentElement.classList.add('js');try{const t=localStorage.th||(matchMedia('(prefers-color-scheme:dark)').matches?'dark':'light');document.documentElement.dataset.theme=t}catch(e){}</script>
<style is:global>
:root{--bg:#f7f4ee;--bg2:#efeae1;--card:#fffdf9;--ink:#16181d;--ink2:#3d424b;--mu:#6f747c;--ln:#e2dbcf;--teal:#0d8c7f;--teal2:#0a6f65;--tealbg:#dcefeb;--sh:0 1px 2px rgba(22,24,29,.04),0 12px 32px -12px rgba(22,24,29,.12);--serif:'Fraunces',Georgia,serif;--sans:'Inter',system-ui,sans-serif;--r:22px}
[data-theme=dark]{--bg:#0e1113;--bg2:#14181b;--card:#171c1f;--ink:#f1ede6;--ink2:#c9c5bd;--mu:#8d9297;--ln:#262d31;--teal:#3cc9b5;--teal2:#5fd8c6;--tealbg:#123430;--sh:0 1px 2px rgba(0,0,0,.3),0 18px 40px -18px rgba(0,0,0,.6)}
*{box-sizing:border-box}html{scroll-behavior:smooth;scroll-padding-top:84px}
body{margin:0;background:var(--bg);color:var(--ink);font:400 17px/1.65 var(--sans);-webkit-font-smoothing:antialiased;text-rendering:optimizeLegibility}
img{max-width:100%;display:block}a{color:inherit;text-decoration:none}
.w{width:min(1180px,100% - 40px);margin-inline:auto}
.ey{font:600 12px/1 var(--sans);letter-spacing:.16em;text-transform:uppercase;color:var(--teal)}
h1,h2,h3{font-family:var(--serif);font-weight:500;letter-spacing:-.02em;margin:0;line-height:1.08}
.em{font-style:italic;color:var(--teal)}
.btn{display:inline-flex;align-items:center;gap:10px;height:50px;padding:0 24px;border-radius:99px;font:600 15px var(--sans);border:1px solid var(--ln);background:var(--card);color:var(--ink);transition:transform .25s,background .25s,border-color .25s,box-shadow .25s;cursor:pointer}
.btn:hover{transform:translateY(-2px);border-color:var(--ink);box-shadow:var(--sh)}
.btn.p{background:var(--ink);color:var(--bg);border-color:var(--ink)}.btn.p:hover{background:var(--teal);border-color:var(--teal);color:#fff}
.btn svg{width:18px;height:18px;transition:transform .25s}.btn:hover svg{transform:translateX(3px)}
/* nav */
.nav{position:sticky;top:0;z-index:50;background:color-mix(in srgb,var(--bg) 82%,transparent);backdrop-filter:saturate(1.4) blur(14px);-webkit-backdrop-filter:saturate(1.4) blur(14px);border-bottom:1px solid transparent;transition:border-color .3s}
.nav.sc{border-color:var(--ln)}
.nav .w{display:flex;align-items:center;gap:28px;height:72px}
.brand{display:flex;align-items:center;gap:10px;font:600 17px var(--serif);letter-spacing:-.01em;margin-right:auto}.brand img{width:30px;height:30px;border-radius:9px}
.nav ul{display:flex;gap:26px;list-style:none;margin:0;padding:0;font-size:14.5px;color:var(--ink2)}.nav ul a{position:relative;padding:6px 0}.nav ul a::after{content:'';position:absolute;left:0;right:0;bottom:0;height:1.5px;background:var(--teal);transform:scaleX(0);transform-origin:left;transition:transform .3s}.nav ul a:hover{color:var(--ink)}.nav ul a:hover::after{transform:scaleX(1)}
.ico{width:42px;height:42px;border-radius:50%;display:grid;place-items:center;border:1px solid var(--ln);background:var(--card);cursor:pointer;color:var(--ink)}.ico svg{width:18px;height:18px}
.nav .btn{height:42px;padding:0 18px;font-size:14px}
#mb{display:none}
/* hero */
.hero{padding:72px 0 40px}
.hg{display:grid;grid-template-columns:1.25fr .85fr;gap:64px;align-items:center}
.hero h1{font-size:clamp(46px,6.6vw,92px);margin:22px 0 26px}
.lead{font-size:clamp(17px,1.5vw,20px);color:var(--ink2);max-width:34ch;margin:0 0 34px}
.cta{display:flex;flex-wrap:wrap;gap:12px}
.pf{position:relative;justify-self:end;width:min(100%,420px)}
.arch{aspect-ratio:4/5;border-radius:999px 999px 28px 28px;overflow:hidden;background:var(--tealbg);box-shadow:var(--sh)}
.arch img{width:100%;height:100%;object-fit:cover;transition:transform 1.2s cubic-bezier(.2,.7,.2,1)}.pf:hover .arch img{transform:scale(1.04)}
.tagc{position:absolute;left:-34px;bottom:44px;background:var(--card);border:1px solid var(--ln);border-radius:18px;padding:14px 18px;box-shadow:var(--sh);display:flex;gap:12px;align-items:center;font-size:14px;line-height:1.3}
.tagc i{width:10px;height:10px;border-radius:50%;background:#22c55e;box-shadow:0 0 0 5px color-mix(in srgb,#22c55e 25%,transparent);animation:pl 2.4s infinite}
@keyframes pl{50%{box-shadow:0 0 0 9px transparent}}
.tagc b{display:block;font-weight:600}.tagc span{color:var(--mu)}
.stats{display:grid;grid-template-columns:repeat(4,1fr);gap:0;margin-top:72px;border-top:1px solid var(--ln);border-bottom:1px solid var(--ln)}
.stats div{padding:26px 0 24px;border-right:1px solid var(--ln);padding-left:28px}.stats div:first-child{padding-left:0}.stats div:last-child{border:0}
.stats b{display:block;font:500 clamp(30px,3.4vw,44px)/1 var(--serif);letter-spacing:-.02em}.stats span{font-size:14px;color:var(--mu)}
/* sections */
section{padding:110px 0}
.sh{display:grid;grid-template-columns:260px 1fr;gap:48px;margin-bottom:54px;align-items:end}
.sh h2{font-size:clamp(36px,4.4vw,60px)}
.sh p{margin:0;color:var(--ink2);max-width:52ch}
/* about */
.ab{display:grid;grid-template-columns:260px 1fr;gap:48px}
.ab .big{font:400 clamp(26px,2.8vw,38px)/1.25 var(--serif);letter-spacing:-.015em;margin:0 0 28px}
.ab .tx p{color:var(--ink2);margin:0 0 18px;max-width:64ch}
.ab .side{position:sticky;top:110px;align-self:start}
.ab .side img{width:120px;height:120px;border-radius:50%;object-fit:cover;margin-top:24px;border:4px solid var(--card);box-shadow:var(--sh)}
.tl{list-style:none;padding:0;margin:40px 0 0;border-top:1px solid var(--ln)}
.tl li{display:grid;grid-template-columns:180px 1fr;gap:24px;padding:22px 0;border-bottom:1px solid var(--ln)}
.tl .d{color:var(--mu);font-size:14px}.tl h3{font-size:22px}.tl p{margin:6px 0 0;color:var(--ink2);font-size:15.5px}
/* work */
.chips{display:flex;flex-wrap:wrap;gap:8px;margin-bottom:28px}
.chip{height:40px;padding:0 18px;border-radius:99px;border:1px solid var(--ln);background:transparent;font:500 14px var(--sans);color:var(--ink2);cursor:pointer;transition:all .2s}
.chip:hover{border-color:var(--ink);color:var(--ink)}.chip[aria-pressed=true]{background:var(--ink);border-color:var(--ink);color:var(--bg)}
.grid{display:grid;grid-template-columns:repeat(3,1fr);gap:22px}
.pj{display:flex;flex-direction:column;background:var(--card);border:1px solid var(--ln);border-radius:var(--r);overflow:hidden;transition:transform .35s cubic-bezier(.2,.7,.2,1),box-shadow .35s,border-color .35s}
.pj:hover{transform:translateY(-6px);box-shadow:var(--sh);border-color:color-mix(in srgb,var(--teal) 40%,var(--ln))}
.pj .cv{aspect-ratio:16/10;background:linear-gradient(135deg,var(--tealbg),var(--bg2));display:grid;place-items:center;overflow:hidden}
.pj .cv img{width:100%;height:100%;object-fit:cover;transition:transform .8s cubic-bezier(.2,.7,.2,1)}.pj:hover .cv img{transform:scale(1.05)}
.pj .cv span{font:500 64px var(--serif);color:var(--teal);opacity:.55;font-style:italic}
.pj .bd{padding:22px 24px 24px;display:flex;flex-direction:column;flex:1}
.pj small{font:600 11.5px var(--sans);letter-spacing:.14em;text-transform:uppercase;color:var(--mu)}
.pj h3{font-size:25px;margin:8px 0 10px;display:flex;justify-content:space-between;gap:12px}.pj h3 svg{flex:none;width:22px;height:22px;color:var(--teal);transition:transform .3s}.pj:hover h3 svg{transform:translate(3px,-3px)}
.pj p{margin:0 0 18px;color:var(--ink2);font-size:15.5px}
.tags{display:flex;flex-wrap:wrap;gap:6px;margin-top:auto}.tags span{font-size:12.5px;padding:4px 10px;border-radius:99px;background:var(--bg2);color:var(--ink2)}
.pj[hidden]{display:none}
/* services */
.svc{list-style:none;padding:0;margin:0;border-top:1px solid var(--ln)}
.svc li{display:grid;grid-template-columns:260px 1fr 40px;gap:48px;align-items:baseline;padding:34px 0;border-bottom:1px solid var(--ln);transition:padding .3s}
.svc li:hover{padding-left:12px}.svc .n{font:italic 400 22px var(--serif);color:var(--teal)}
.svc h3{font-size:clamp(24px,2.4vw,32px)}.svc p{margin:10px 0 0;color:var(--ink2);max-width:58ch}
.svc .ar{color:var(--mu);transition:color .3s,transform .3s}.svc li:hover .ar{color:var(--teal);transform:translateX(6px)}
/* stack */
.stk{display:grid;grid-template-columns:repeat(auto-fill,minmax(150px,1fr));gap:14px}
.stk div{display:flex;align-items:center;gap:12px;padding:14px 16px;border:1px solid var(--ln);border-radius:16px;background:var(--card);font-weight:500;font-size:15px;transition:transform .25s,border-color .25s}
.stk div:hover{transform:translateY(-3px);border-color:var(--c)}
.stk i{width:34px;height:34px;flex:none;border-radius:10px;display:grid;place-items:center;font:700 12px var(--sans);font-style:normal;color:#fff;background:var(--c)}.stk img{width:34px;height:34px;object-fit:contain}
/* certs */
.crt{display:grid;grid-template-columns:repeat(4,1fr);gap:18px}
.cc{background:var(--card);border:1px solid var(--ln);border-radius:18px;overflow:hidden;display:flex;flex-direction:column;transition:transform .3s,box-shadow .3s}.cc:hover{transform:translateY(-4px);box-shadow:var(--sh)}
.cc .im{aspect-ratio:4/3;background:var(--bg2)}.cc .im img{width:100%;height:100%;object-fit:cover}
.cc .bd{padding:16px 18px 18px}.cc h3{font-size:18px;line-height:1.25}.cc p{margin:6px 0 10px;color:var(--mu);font-size:14px}.cc a.l{font-size:14px;font-weight:600;color:var(--teal)}
/* writing */
.posts{display:grid;grid-template-columns:repeat(3,1fr);gap:28px}
.pt .im{aspect-ratio:3/2;border-radius:18px;overflow:hidden;background:var(--bg2);margin-bottom:18px}.pt .im img{width:100%;height:100%;object-fit:cover;transition:transform .8s cubic-bezier(.2,.7,.2,1)}.pt:hover .im img{transform:scale(1.05)}
.pt small{color:var(--teal);font-weight:600;font-size:13px}.pt h3{font-size:24px;margin:8px 0}.pt p{margin:0;color:var(--mu);font-size:14px}
.pt:hover h3{text-decoration:underline;text-decoration-color:var(--teal);text-underline-offset:5px;text-decoration-thickness:1.5px}
/* contact */
.ct{background:var(--ink);color:var(--bg);border-radius:36px;padding:clamp(40px,7vw,96px);position:relative;overflow:hidden}
.ct::before{content:'';position:absolute;right:-120px;top:-120px;width:420px;height:420px;border-radius:50%;background:radial-gradient(circle,color-mix(in srgb,var(--teal) 55%,transparent),transparent 70%);opacity:.6}
.ct h2{font-size:clamp(40px,6vw,84px);max-width:14ch;position:relative}.ct h2 .em{color:#5fd8c6}
.ct p{color:color-mix(in srgb,var(--bg) 72%,transparent);max-width:46ch;font-size:18px;margin:22px 0 36px;position:relative}
.ct .btn{background:transparent;color:var(--bg);border-color:color-mix(in srgb,var(--bg) 30%,transparent)}.ct .btn:hover{border-color:var(--bg);box-shadow:none}
.ct .btn.p{background:#5fd8c6;border-color:#5fd8c6;color:#0e1113}.ct .btn.p:hover{background:#fff;border-color:#fff}
.ct .cta{position:relative}
.cvb{display:flex;justify-content:space-between;align-items:center;gap:24px;flex-wrap:wrap;padding:34px 0;border-top:1px solid var(--ln);border-bottom:1px solid var(--ln)}.cvb h3{font-size:30px}
footer{padding:48px 0 60px;color:var(--mu);font-size:14px}footer .w{display:flex;justify-content:space-between;gap:20px;flex-wrap:wrap}footer nav{display:flex;gap:20px;flex-wrap:wrap}footer a:hover{color:var(--ink)}
/* reveal on scroll */
.js .rv{opacity:0;transform:translateY(24px);transition:opacity .9s cubic-bezier(.2,.7,.2,1),transform .9s cubic-bezier(.2,.7,.2,1)}.js .rv.in{opacity:1;transform:none}
@media(prefers-reduced-motion:reduce){.js .rv{opacity:1;transform:none;transition:none}*{animation:none!important;transition:none!important}}
/* responsive */
@media(max-width:1020px){.pj .cv:has(span){aspect-ratio:16/7}.grid,.posts{grid-template-columns:1fr 1fr}.crt{grid-template-columns:repeat(3,1fr)}.nav ul{gap:18px}}
@media(max-width:860px){
  body{font-size:16px}section{padding:76px 0}
  .nav ul{display:none;position:absolute;top:72px;left:0;right:0;flex-direction:column;gap:0;background:var(--bg);border-bottom:1px solid var(--ln);padding:8px 20px 20px;font-size:18px}
  .nav.open ul{display:flex}.nav ul a{display:block;padding:14px 0;border-bottom:1px solid var(--ln)}.nav ul a::after{display:none}
  #mb{display:grid}.nav .btn.hide-s{display:none}
  .hero{padding:36px 0 20px}.hg{grid-template-columns:1fr;gap:40px}.pf{justify-self:center;width:min(100%,340px);order:-1}
  .tagc{left:50%;transform:translateX(-50%);bottom:-22px;white-space:nowrap}
  .stats{grid-template-columns:1fr 1fr;margin-top:56px}.stats div{padding:20px 0 18px 20px}.stats div:nth-child(2){border-right:0}.stats div:nth-child(3){padding-left:0;border-top:1px solid var(--ln)}.stats div:nth-child(4){border-top:1px solid var(--ln)}
  .sh,.ab{grid-template-columns:1fr;gap:16px}.ab .side{position:static;display:flex;align-items:center;gap:16px}.ab .side img{margin:0;width:72px;height:72px}
  .grid,.posts{grid-template-columns:1fr}.crt{grid-template-columns:1fr 1fr}
  .pj .cv:has(span){aspect-ratio:4/1}.pj .cv span{font-size:40px}.svc li{grid-template-columns:44px 1fr;gap:14px}.svc .ar{display:none}
  .tl li{grid-template-columns:1fr;gap:4px}
  .ct{border-radius:26px}
}
</style>
</head>
<body>

<header class="nav" id="nav"><div class="w">
  <a class="brand" href="#top">{s.logo && <img src={s.logo} alt="" />}<span>{s.name}</span></a>
  <ul>
    <li><a href="#about">{s.nav_about || 'About'}</a></li>
    <li><a href="#work">{s.nav_work || 'Work'}</a></li>
    <li><a href="#services">{s.nav_services || 'Services'}</a></li>
    <li><a href={s.blog_url || '/blog/'}>{s.nav_blog || 'Blog'}</a></li>
    <li><a href={s.infobytes_url || '/infobytes/'}>{s.nav_infobytes || 'Infobytes'}</a></li>
    <li><a href="#contact">{s.nav_contact || 'Contact'}</a></li>
  </ul>
  <button class="ico" id="th" aria-label="Switch light or dark theme"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7"><path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8z"/></svg></button>
  <a class="btn p hide-s" href={wa} target="_blank" rel="noopener">Let’s talk</a>
  <button class="ico" id="mb" aria-label="Open menu" aria-expanded="false"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M4 8h16M4 16h16"/></svg></button>
</div></header>

<main id="top">
<section class="hero"><div class="w">
  <div class="hg">
    <div class="rv">
      <span class="ey">{role}</span>
      <h1>{headA} <span class="em">{headB}.</span></h1>
      <p class="lead">{s.cta_text || s.seo_description}</p>
      <div class="cta">
        <a class="btn p" href="#work">See my work <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M5 12h14M13 6l6 6-6 6"/></svg></a>
        <a class="btn" href={wa} target="_blank" rel="noopener">Chat on WhatsApp</a>
      </div>
    </div>
    <div class="pf rv">
      <div class="arch"><img src={s.photo} alt={s.name} fetchpriority="high" /></div>
      <div class="tagc"><i></i><div><b>Open to projects</b><span>{s.short_name ? s.short_name.replace(/\./g, '') + ' · ' : ''}replies within a day</span></div></div>
    </div>
  </div>
  <div class="stats rv">
    <div><b>{work.length}</b><span>Projects delivered</span></div>
    <div><b>{services.length}</b><span>Services offered</span></div>
    <div><b>{certs.length}</b><span>Certifications</span></div>
    <div><b>{tools.length}+</b><span>Tools in my stack</span></div>
  </div>
</div></section>

<section id="about"><div class="w ab">
  <div class="side rv"><span class="ey">{s.about_title || 'About me'}</span>{about.profile_photo && <img src={about.profile_photo} alt="" />}</div>
  <div class="tx rv">
    {greeting && <p class="big">{greeting}</p>}
    {story.map((p) => <p>{p}</p>)}
    {exp.length > 0 && <ul class="tl">{exp.map((e) => <li><span class="d">{mo(e.start)}{e.start ? ' – ' + (e.end && e.end !== 'Present' ? mo(e.end) : 'Present') : ''}</span><div><h3>{e.role}</h3><p>{e.org}{e.description ? ' · ' + e.description : ''}</p></div></li>)}</ul>}
  </div>
</div></section>

{work.length > 0 && <section id="work" style="background:var(--bg2)"><div class="w">
  <div class="sh rv"><span class="ey">{s.work_title || 'My work'}</span><div><h2>Selected <span class="em">work</span></h2></div></div>
  {groups.length > 1 && <div class="chips rv" role="group" aria-label="Filter projects"><button class="chip" aria-pressed="true" data-f="all">All</button>{groups.map((g) => <button class="chip" aria-pressed="false" data-f={g.k}>{g.label}</button>)}</div>}
  <div class="grid">
    {work.map((p) => (
      <a class="pj rv" href={`/projects/${p.slug}/`} data-c={p.category || 'other'}>
        <div class="cv">{p.cover_image ? <img src={p.cover_image} alt="" loading="lazy" /> : <span>{initials(p.title)}</span>}</div>
        <div class="bd">
          <small>{GROUPS.find(([k]) => k === (p.category || 'other'))?.[1]}</small>
          <h3>{p.title}<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M7 17 17 7M9 7h8v8"/></svg></h3>
          <p>{p.description}</p>
          {p.tools?.length > 0 && <div class="tags">{p.tools.map((t) => <span>{t}</span>)}</div>}
        </div>
      </a>
    ))}
  </div>
</div></section>}

{services.length > 0 && <section id="services"><div class="w">
  <div class="sh rv"><span class="ey">{s.services_title || 'Services'}</span><div><h2>How I can <span class="em">help</span></h2></div></div>
  <ul class="svc">
    {services.map((x, i) => <li class="rv"><span class="n">{String(i + 1).padStart(2, '0')}</span><div><h3>{x.title}</h3>{x.text && <p>{x.text}</p>}</div><span class="ar">→</span></li>)}
  </ul>
</div></section>}

{tools.length > 0 && <section id="stack" style="padding-top:0"><div class="w">
  <div class="sh rv"><span class="ey">{s.stack_title || 'My stack'}</span><div><h2>Tools I <span class="em">trust</span></h2></div></div>
  <div class="stk rv">{tools.map((t) => <div style={`--c:${t.color || 'var(--teal)'}`}>{t.logo ? <img src={t.logo} alt="" loading="lazy" /> : <i>{initials(t.name)}</i>}{t.name}</div>)}</div>
</div></section>}

{certs.length > 0 && <section id="certs" style="padding-top:0"><div class="w">
  <div class="sh rv"><span class="ey">{s.tab_certs || 'Certifications'}</span><div><h2>Always <span class="em">learning</span></h2></div></div>
  <div class="crt">
    {certs.map((c) => (
      <div class="cc rv">
        {c.certificate_image && <a class="im" href={c.certificate_image} target="_blank" rel="noopener"><img src={c.certificate_image} alt={c.name} loading="lazy" /></a>}
        <div class="bd"><h3>{c.name}</h3><p>{[c.issuer, c.year].filter(Boolean).join(' · ')}</p>{c.link && <a class="l" href={c.link} target="_blank" rel="noopener">View credential →</a>}</div>
      </div>
    ))}
  </div>
</div></section>}

{posts.length > 0 && <section id="writing" style="background:var(--bg2)"><div class="w">
  <div class="sh rv"><span class="ey">{s.nav_blog || 'Blog'}</span><div style="display:flex;justify-content:space-between;align-items:end;gap:20px;flex-wrap:wrap"><h2>Latest <span class="em">writing</span></h2><a class="btn" href={s.blog_url || '/blog/'}>All posts <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M5 12h14M13 6l6 6-6 6"/></svg></a></div></div>
  <div class="posts">
    {posts.map((p) => <a class="pt rv" href={`/blog/${p.slug}/`}><div class="im">{p.image && <img src={p.image} alt="" loading="lazy" />}</div><small>{p.category}</small><h3>{p.title}</h3><p>{fdate(p.date)} · {p.mins} min read</p></a>)}
  </div>
</div></section>}

<section id="contact"><div class="w">
  {s.cv && <div class="cvb rv" style="margin-bottom:60px"><h3>{s.cv_title || 'Want the full picture?'}</h3><a class="btn p" href={s.cv} target="_blank" rel="noopener">{s.cv_button || 'Download my CV'}</a></div>}
  <div class="ct rv">
    <span class="ey" style="color:#5fd8c6">{s.nav_contact || 'Contact'}</span>
    <h2>{(s.cta_title || 'Got a problem to solve?').replace(/\?$/, '')}<span class="em">?</span></h2>
    <p>{s.cta_text}</p>
    <div class="cta">
      <a class="btn p" href={wa} target="_blank" rel="noopener">Start on WhatsApp</a>
      {socials.map(([n, u]) => <a class="btn" href={u} target="_blank" rel="noopener">{n}</a>)}
    </div>
  </div>
</div></section>
</main>

<footer><div class="w"><span>{s.footer}</span><nav><a href="/about/">About</a><a href="/contact/">Contact</a><a href="/privacy/">Privacy</a><a href="/terms/">Terms</a><a href="/disclaimer/">Disclaimer</a></nav></div></footer>

<script is:inline>
(() => {
  const R = document.documentElement, nav = document.getElementById('nav'), mb = document.getElementById('mb');
  document.getElementById('th').onclick = () => { R.dataset.theme = R.dataset.theme === 'dark' ? 'light' : 'dark'; try { localStorage.th = R.dataset.theme; } catch (e) {} };
  mb.onclick = () => mb.setAttribute('aria-expanded', nav.classList.toggle('open'));
  nav.querySelectorAll('ul a').forEach((a) => a.addEventListener('click', () => { nav.classList.remove('open'); mb.setAttribute('aria-expanded', 'false'); }));
  addEventListener('scroll', () => nav.classList.toggle('sc', scrollY > 10), { passive: true });
  const io = 'IntersectionObserver' in window ? new IntersectionObserver((es) => es.forEach((e) => { if (e.isIntersecting) { e.target.classList.add('in'); io.unobserve(e.target); } }), { rootMargin: '0px 0px -8% 0px' }) : null;
  document.querySelectorAll('.rv').forEach((el, i) => { el.style.transitionDelay = (i % 3) * 80 + 'ms'; io ? io.observe(el) : el.classList.add('in'); });
  document.querySelectorAll('.chip').forEach((b) => b.onclick = () => {
    document.querySelectorAll('.chip').forEach((x) => x.setAttribute('aria-pressed', x === b));
    document.querySelectorAll('.pj').forEach((p) => p.hidden = b.dataset.f !== 'all' && p.dataset.c !== b.dataset.f);
  });
})();
</script>
</body>
</html>
