---
// Live headlines collected hourly by the Worker (Google News + Bing News), ranked by priority.
import Shell from '../../layouts/Shell.astro';
---
<Shell title="News" desc="Top stories for every topic we cover, updated every hour." ads={false} active="news">
<h2>News</h2>
<p class="sub">The top stories for every topic we cover, updated every hour. <span id="upd"></span></p>
<div class="fl" id="nchips" style="display:flex;gap:8px;flex-wrap:wrap;margin:18px 0"></div>
<div id="nlist"><p class="sub">Loading headlines…</p></div>
<style is:global>
.nf-i{display:block;background:none;border-radius:0;padding:16px 0;border-bottom:1px solid var(--ln);color:inherit;text-decoration:none}
.nf-i b{display:block;text-transform:none;letter-spacing:0;color:var(--tx);font-weight:600;font-size:17px;line-height:1.35}.nf-i:hover b{color:var(--teal)}
.nf-i small{display:block;margin-top:4px;color:var(--mu);text-transform:none;letter-spacing:0;font-weight:400}.nf-top{display:inline-block;color:#fff;background:#e8763a;border-radius:99px;padding:1px 8px;font-size:11px;font-weight:700;margin-right:6px}
.nf-c{border:1px solid var(--ln);background:none;color:inherit;border-radius:99px;padding:6px 14px;cursor:pointer;font:inherit}.nf-c.on{background:var(--teal);border-color:var(--teal);color:#fff}
</style>
<script is:inline>
(async () => {
  const L = document.getElementById('nlist'), C = document.getElementById('nchips');
  const esc = (s) => String(s || '').replace(/[&<>"]/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' }[c]));
  const ago = (d) => { const h = (Date.now() - new Date(d)) / 36e5; return h < 1 ? Math.max(1, Math.round(h * 60)) + ' min ago' : h < 24 ? Math.round(h) + ' h ago' : Math.round(h / 24) + ' d ago'; };
  let d;
  try { d = await (await fetch('/api/news')).json(); } catch { L.innerHTML = '<p class="sub">Headlines are not available right now. Please try again shortly.</p>'; return; }
  if (!d.categories.length) { L.innerHTML = '<p class="sub">Headlines are on the way. Check back soon.</p>'; return; }
  if (d.generated) document.getElementById('upd').textContent = 'Last updated ' + ago(d.generated) + '.';
  const draw = (slug) => {
    C.querySelectorAll('button').forEach((b) => b.classList.toggle('on', b.dataset.s === slug));
    const items = slug === 'all' ? d.categories.flatMap((c) => c.items.slice(0, 4).map((i) => ({ ...i, cat: c.name }))).sort((a, b) => b.score - a.score) : d.categories.find((c) => c.slug === slug).items;
    L.innerHTML = items.map((i) => `<a class="nf-i" href="${esc(i.link)}" target="_blank" rel="noopener nofollow"><b>${i.priority === 'high' ? '<span class="nf-top">TOP</span>' : ''}${esc(i.title)}</b><small>${esc(i.source)} · ${ago(i.published)}${i.cat ? ' · ' + esc(i.cat) : ''}</small></a>`).join('');
  };
  C.innerHTML = '<button class="nf-c" data-s="all">Top stories</button>' + d.categories.map((c) => `<button class="nf-c" data-s="${esc(c.slug)}">${esc(c.name)}</button>`).join('');
  C.onclick = (e) => { const b = e.target.closest('button'); if (b) draw(b.dataset.s); };
  draw('all');
})();
</script>
</Shell>
