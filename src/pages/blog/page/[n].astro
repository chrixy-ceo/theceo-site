---
import Shell from '../../../layouts/Shell.astro';
import BlogList from '../../../components/BlogList.astro';
import { site } from '../../../lib/content.js';
import { getPosts } from '../../../lib/posts.js';
const posts = getPosts();
const { n } = Astro.params;
if (!/^\d+$/.test(n) || +n < 2 || +n > Math.ceil(posts.length / 5)) return Astro.rewrite('/404');
---
<Shell title={site.blog_title + ' – page ' + n} desc={site.blog_description} image={site.blog_og_image} active="blog"><BlogList n={+n} /></Shell>
