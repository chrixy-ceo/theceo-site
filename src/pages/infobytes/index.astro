---
import Shell from '../../layouts/Shell.astro';
import AdSlot from '../../components/AdSlot.astro';
import Newsletter from '../../components/Newsletter.astro';
import site from '../../content/site.json';
import { ops } from '../../lib/ops.js';
const OPS = ops.map(({ Content, ...o }) => o);
const LOGO = site.infobytes_logo || '';
---
<Shell title={site.infobytes_title} desc={site.infobytes_description} header={false} active="info">
<div class="ih">{LOGO ? <img class="lg" src={LOGO} alt="Infobytes logo" /> : <div class="lg mk">Ib</div>}<div><h2>Infobytes</h2></div><button class="btn tgl" id="th2" aria-label="Toggle light and dark theme">◐</button></div>
<Newsletter where="info" />
<div class="ctl"><input id="q" type="search" placeholder="Search opportunities" aria-label="Search opportunities" /><div class="fl" id="chips"></div></div>
<AdSlot /><div id="il"></div><AdSlot />
<script define:vars={{ OPS }}>
const $=s=>document.querySelector(s),CC={Tech:"#14b8a6",Scholarships:"#d9a441",Jobs:"#5b8def",Fellowships:"#d9627f",Other:"#8b7cf6"},cats=["All","Tech","Scholarships","Jobs","Fellowships","Other"];
let F="All",Q="",PG=1;const dleft=d=>Math.ceil((new Date(d)-new Date())/864e5);
const iord=(a,b)=>{const x=dleft(a.deadline),y=dleft(b.deadline);return (x>0)==(y>0)?(x>0?x-y:y-x):(x>0?-1:1)};
const thumb=p=>`<div class="tw" style="--c:${CC[p.category]||"#14b8a6"}">${p.image?`<img class="th" src="${p.image}" alt="">`:`<div class="th ph3"><svg viewBox="0 0 24 24"><rect x="3" y="4" width="18" height="16" rx="3"/><path d="M3 17l5-5 4 4 3-3 6 5M8.5 9h.01"/></svg></div>`}</div>`;
const row=p=>{const d=dleft(p.deadline);return `<a class="it" href="/infobytes/${p.slug}/" style="--c:${CC[p.category]||"#14b8a6"}"><div class="im"><small>${p.category}</small><h3>${p.title}</h3><p>${[p.organization,p.location,p.type].filter(Boolean).join(" · ")}</p><span class="dd${d>0&&d<=14?" u":""}">${d>0?d+" days left":"Closed"}</span></div>${thumb(p)}</a>`};
const pager=(n,sz)=>{const t=Math.ceil(n/sz);if(t<2)return"";let b=`<button class="pb" data-pg="${PG-1}" ${PG<2?"disabled":""}>← Prev</button>`;for(let i=1;i<=t;i++)b+=`<button class="pb${i==PG?" on":""}" data-pg="${i}">${i}</button>`;return `<div class="pgr">${b}<button class="pb" data-pg="${PG+1}" ${PG>=t?"disabled":""}>Next →</button></div>`};
function chips(){$("#chips").innerHTML=cats.map(c=>`<button data-f="${c}" aria-pressed="${c==F}">${c!="All"?`<i style="background:${CC[c]}"></i>`:""}${c}<em>${c=="All"?OPS.length:OPS.filter(p=>p.category==c).length}</em></button>`).join("")}
function lst(){const r=OPS.filter(p=>(F=="All"||p.category==F)&&((p.title||"")+(p.organization||"")).toLowerCase().includes(Q)).sort(iord),pg=r.slice((PG-1)*6,PG*6);$("#il").innerHTML=pg.length?`<div class="gg">${pg.map(row).join("")}</div>${pager(r.length,6)}`:`<p class="sub">${OPS.length?"No opportunities match your search.":"No opportunities listed right now. Check back soon."}</p>`}
document.addEventListener("click",e=>{const g=e.target.closest("[data-pg]");if(g){if(!g.disabled){PG=+g.dataset.pg;lst();$("#il").scrollIntoView({behavior:"smooth"})}return}const b=e.target.closest("[data-f]");if(b){F=b.dataset.f;PG=1;chips();lst()}});
$("#q").oninput=e=>{Q=e.target.value.toLowerCase();PG=1;lst()};chips();lst();
</script>
</Shell>
