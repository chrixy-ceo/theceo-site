---
import { pages, renderMarkdown } from '../lib/content.js';
import Shell from '../layouts/Shell.astro';
import { settings as s } from '../lib/content.js';
import { site } from '../lib/content.js';
const { slug } = Astro.params;
const pg = pages.find((x) => x.slug === slug);
if (!pg) return Astro.rewrite('/404');
const fm = pg.fm;
---
<Shell title={fm.title + ' | ' + s.name} desc={fm.description || fm.title} image={fm.og_image} ads={false}>
<article class="ar2" style="max-width:720px"><h1>{fm.title}</h1>{fm.updated && <p class="meta">Last updated: {fm.updated}</p>}<Fragment set:html={renderMarkdown(pg.body)} />
{slug == 'contact' && <div class="sh row"><a class="btn p" href={`https://wa.me/${s.whatsapp}`} target="_blank" rel="noopener">WhatsApp</a>{site.contact_email && <a class="btn" href={`mailto:${site.contact_email}`}>Email</a>}<a class="btn" href={s.linkedin} target="_blank" rel="noopener">LinkedIn</a><a class="btn" href={s.x} target="_blank" rel="noopener">X</a><a class="btn" href={s.github} target="_blank" rel="noopener">GitHub</a></div>}
</article>
</Shell>
