---
import '../styles/site.css';
import s from '../content/settings.json';
import about from '../content/about.json';
import sv from '../content/services.json';
import st from '../content/stack.json';
import site from '../content/site.json';
const g = (m) => Object.values(m).map((x) => x.default);
const proj = g(import.meta.glob('../content/projects/*.json', { eager: true }));
const exp = g(import.meta.glob('../content/experience/*.json', { eager: true }));
const cer = g(import.meta.glob('../content/certifications/*.json', { eager: true }));
const CATS = [['Analysis projects', 'analysis'], ['Automation projects', 'automation'], ['Other projects built', 'other']];
const W = CATS.map(([t, k]) => [t, proj.filter((x) => x.category == k).sort((a, b) => String(b.date || '').localeCompare(String(a.date || ''))).map((x) => [x.title, x.description, x.tools || [], x.link || ''])]);
const EX = exp.map((e) => [e.role, e.org, e.start || '', e.end || '', e.description || '']);
const CE = cer.map((c) => [c.name, c.issuer || '', String(c.year || ''), c.link || '']);
const STACK = st.tools, ABOUT = about.paragraphs, services = sv.items;
---
<!DOCTYPE html><html lang="en" data-theme="dark"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width, initial-scale=1"><title>{s.seo_title}</title><meta name="description" content={s.seo_description}><link rel="icon" href="data:,">{site.adsense_client && <meta name="google-adsense-account" content={site.adsense_client} />}<link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet"></head><body>

<nav><div class="w"><a class="logo" href="#top" aria-label={s.name+", home"}><span class="fn">{s.name}</span><span class="so" set:html={s.short_name.replace(/\./g,"<b>.</b>")}></span></a>
<ul><li><a href="#about">{s.nav_about}</a></li><li><a href="#work">{s.nav_work}</a></li><li><a href="#services">{s.nav_services}</a></li><li><a href="#stack">{s.nav_stack}</a></li><li><a href={s.blog_url}>{s.nav_blog}</a></li><li><a href={s.infobytes_url}>{s.nav_infobytes}</a></li>{s.cv && <li><a href="#cvs">{s.nav_cv}</a></li>}<li><a href="#contact">{s.nav_contact}</a></li></ul>
<a class="btn p wa mg" aria-label="Chat on WhatsApp" href={"https://wa.me/"+s.whatsapp} target="_blank" rel="noopener"><svg role="img" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413Z"/></svg></a><button class="btn" id="th" aria-label="Toggle light and dark theme">◐</button><button class="btn" id="bg" aria-label="Open menu" aria-expanded="false"><span></span><span></span><span></span></button></div></nav>

<div id="home"><header class="hero" id="top"><canvas id="cv"></canvas><div class="w hc">
<div class="ph"><svg class="rg" viewBox="0 0 600 600" aria-hidden="true"><circle cx="300" cy="300" r="190"/><circle cx="300" cy="300" r="290" style="opacity:.5"/><g class="o"><circle cx="300" cy="300" r="240" stroke-dasharray="3 7"/><circle class="dt" cx="540" cy="300" r="5"/><circle class="dt" cx="130" cy="130" r="3.5"/></g><g class="o o2"><circle class="dt" cx="300" cy="10" r="4"/><circle class="dt" cx="95" cy="505" r="3"/></g></svg><div id="tl"><img id="ph" alt={s.name} src={s.photo}></div></div>
<h1 class="st">{s.headline}</h1>

</div></header><section id="about"><div class="w"><h2>{s.about_title}</h2><div class="tabs2" role="tablist"><button role="tab" data-t="ab" aria-selected="true">{s.tab_about}</button><button role="tab" data-t="ex" aria-selected="false">{s.tab_experience}</button><button role="tab" data-t="ce" aria-selected="false">{s.tab_certs}</button></div><div id="tp"></div></div></section><section id="work"><div class="w"><h2>{s.work_title}</h2><div class="wk" id="wk"></div></div></section><section id="contact"><div class="w"><div class="cta"><h2>{s.cta_title}</h2><p style="opacity:.8;max-width:44ch;margin:auto">{s.cta_text}</p>
<div class="row"><a class="btn big mg" href={"https://wa.me/"+s.whatsapp} target="_blank" rel="noopener">WhatsApp</a><a class="btn big mg" href={s.linkedin} target="_blank" rel="noopener">LinkedIn</a><a class="btn big mg" href={s.x} target="_blank" rel="noopener">X</a><a class="btn big mg" href={s.github} target="_blank" rel="noopener">GitHub</a></div></div></div></section><section id="services"><div class="w"><h2>{s.services_title}</h2><ul class="sl">{services.map((x)=>(<li><span class="dm"></span><div><h3>{x.title}</h3><p>{x.text}</p></div></li>))}</ul></div></section><section id="stack"><div class="w"><h2>{s.stack_title}</h2><div class="stk" id="sk"></div></div></section>{s.cv && (<section id="cvs"><div class="w"><div class="cvc"><div><h2>{s.cv_title}</h2></div><a class="btn p big mg" href={s.cv} download>{s.cv_button}</a></div></div></section>)}










</div>



<footer><div class="w"><span>{s.footer}</span><span class="legal"><a href="/about/">About</a><a href="/contact/">Contact</a><a href="/privacy/">Privacy</a><a href="/terms/">Terms</a><a href="/disclaimer/">Disclaimer</a></span></div></footer>
<a class="fab mg" href={"https://wa.me/"+s.whatsapp} target="_blank" rel="noopener">Chat on WhatsApp</a>

<script define:vars={{ W, EX, CE, STACK, ABOUT }}>

