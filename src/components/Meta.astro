---
import s from '../content/settings.json';
const { title, description = '', image = '', path = Astro.url.pathname, type = 'website' } = Astro.props;
const ORIGIN = 'https://theceo.dev';
const abs = (u) => (u ? (/^https?:\/\//.test(u) ? u : ORIGIN + (u.startsWith('/') ? u : '/' + u)) : '');
const img = abs(image || s.default_og_image || '/uploads/og-default.png');
const url = ORIGIN + path;
const desc = description || s.seo_description;
const icon = s.favicon || '/uploads/favicon.png';
---
<title>{title}</title><meta name="description" content={desc} /><link rel="canonical" href={url} /><link rel="icon" href={icon} />
<meta property="og:type" content={type} /><meta property="og:title" content={title} /><meta property="og:description" content={desc} /><meta property="og:image" content={img} /><meta property="og:url" content={url} /><meta property="og:site_name" content={s.name} />
<meta name="twitter:card" content="summary_large_image" /><meta name="twitter:title" content={title} /><meta name="twitter:description" content={desc} /><meta name="twitter:image" content={img} />
