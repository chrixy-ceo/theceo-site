---
import Shell from '../../../layouts/Shell.astro';
import BlogList from '../../../components/BlogList.astro';
import site from '../../../content/site.json';
import { posts } from '../../../lib/posts.js';
export function getStaticPaths() { const t = Math.ceil(posts.length / 5); return Array.from({ length: Math.max(0, t - 1) }, (_, i) => ({ params: { n: String(i + 2) } })); }
const { n } = Astro.params;
---
<Shell title={site.blog_title + ' – page ' + n} desc={site.blog_description} active="blog"><BlogList n={+n} /></Shell>
